# Variante A: eingebauter PHP-Server als systemd-Dienst
# Kopieren nach /etc/systemd/system/sparkassentracker.service
# Pfad und Benutzer ggf. anpassen.

[Unit]
Description=Sparkassentracker (PHP)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/sparkassentracker
ExecStart=/usr/bin/php -S 0.0.0.0:8081 -t /opt/sparkassentracker/public
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
